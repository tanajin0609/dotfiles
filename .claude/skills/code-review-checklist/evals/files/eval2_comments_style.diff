@@ -0,0 +1,20 @@
+import time
+
+
+def fetch_with_retry(url, session, max_retries=3):
+    # ループでリトライする
+    for attempt in range(max_retries):
+        # リクエストを送る
+        response = session.get(url, timeout=5)
+        # ステータスコードが200なら返す
+        if response.status_code == 200:
+            return response
+        # 429の場合はサーバー側のレート制限。Retry-Afterヘッダーを尊重しないと
+        # 相手のレート制限ロジックと衝突して余計にリトライが増えるため、明示的に待つ
+        if response.status_code == 429:
+            wait = int(response.headers.get('Retry-After', 1))
+            time.sleep(wait)
+    return None
+
+
+def fetch_with_retry_v2(url, session, max_retries = 3):
+    return fetch_with_retry(url, session, max_retries)
