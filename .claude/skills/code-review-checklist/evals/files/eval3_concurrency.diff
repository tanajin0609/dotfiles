@@ -0,0 +1,15 @@
+class RateLimiter:
+    """複数のワーカースレッドから共有され、同時実行数を max_calls 件までに制限する。"""
+
+    def __init__(self, max_calls):
+        self.max_calls = max_calls
+        self.current_calls = 0
+
+    def try_acquire(self):
+        if self.current_calls < self.max_calls:
+            self.current_calls += 1
+            return True
+        return False
+
+    def release(self):
+        self.current_calls -= 1
